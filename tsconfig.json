{
  "compilerOptions": {
    "lib": [
      "es2024",
      "DOM",
      "DOM.Iterable",
      "esnext.disposable"
    ],
    "target": "es2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "@square/web-payments-sdk-types"
    ]
  }
}
